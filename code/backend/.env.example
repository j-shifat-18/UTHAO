NODE_ENV=production
PORT=5000

# Database (Supabase — use the pooler URL for serverless)
# Go to: Supabase Dashboard → Project Settings → Database → Connection string → URI
# For serverless/Vercel, use the Session pooler (port 5432) or Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT
JWT_ACCESS_SECRET=your-strong-random-access-secret-here
JWT_REFRESH_SECRET=your-strong-random-refresh-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
# Add your Vercel frontend URL here after deploying
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# Bcrypt
BCRYPT_SALT_ROUNDS=12
